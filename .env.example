# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=parcel_bot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=parcel_bot

# apps/api
API_PORT=3001
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h
# plain-text admin password used to log in to the admin panel
ADMIN_PASSWORD=change_me
# apps/api - вход пользователей сайта
USER_JWT_EXPIRES_IN=30d

# apps/api - токен Telegram-бота, используется для проверки подписи входа через Telegram
BOT_TOKEN=your_telegram_bot_token_from_botfather

# apps/api - разрешённые Origin для CORS (админка и публичный сайт), через запятую
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
ADMIN_ORIGIN=http://localhost:3000

# apps/admin (Nuxt) - публичный URL API
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001
ADMIN_PORT=3000

# apps/client (Nuxt) - публичный сайт
# Окружение сайта: production индексируется, staging — закрыт от поисковиков.
NUXT_PUBLIC_SITE_ENV=production
CLIENT_PORT=3002
NUXT_PUBLIC_BOT_URL=https://t.me/asdicargo_bot
# Вход через Telegram: имя бота без @ (домен сайта должен быть привязан к боту в BotFather)
NUXT_PUBLIC_TELEGRAM_BOT_USERNAME=asdicargo_bot
